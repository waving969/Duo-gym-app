{
  "name": "duo-gym",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply duo-gym --local",
    "db:migrate:remote": "wrangler d1 migrations apply duo-gym --remote",
    "invite": "node scripts/invite.mjs",
    "demo:seed": "node scripts/seed_demo.mjs",
    "test:api": "bash scripts/e2e_local.sh",
    "test:browser": "node scripts/e2e_browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/query-sync-storage-persister": "^5.106.1",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-query-persist-client": "^5.106.1",
    "hono": "^4.13.16",
    "motion": "^14.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "latest",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4"
  },
  "description": "App web para que dos personas lleven juntas su progreso en el gym: rutinas, pesos, cardio, mensajes y notificaciones."
}
